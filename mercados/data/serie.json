,"btc_d":-45.5,"gold_d":-15.78,"eurusd_d":-6.68},{"month":"2026-07","spx":7481.34,"ndq":25623.68,"btc":63853.71,"gold":4073.0,"eurusd":1.1423,"spx_b":333.0,"ndq_b":473.36,"btc_b":7734.97,"gold_b":352.03,"eurusd_b":108.33,"spx_d":0.0,"ndq_d":-2.03,"btc_d":-44.77,"gold_d":-18.86,"eurusd_d":-7.43},{"month":"2026-08","spx":7711.32,"ndq":26388.69,"btc":69480.71,"gold":4411.0,"eurusd":1.1594,"spx_b":343.24,"ndq_b":487.5,"btc_b":8416.6,"gold_b":381.24,"eurusd_b":109.95,"spx_d":0.0,"ndq_d":0.0,"btc_d":-39.91,"gold_d":-12.13,"eurusd_d":-6.05},{"month":"2026-09","spx":7669.41,"ndq":26541.66,"btc":80482.22,"gold":4319.0,"eurusd":1.1505,"spx_b":341.37,"ndq_b":490.32,"btc_b":9749.28,"gold_b":373.29,"eurusd_b":109.1,"spx_d":-0.54,"ndq_d":0.0,"btc_d":-30.39,"gold_d":-13.96,"eurusd_d":-6.77},{"month":"2026-10","spx":7726.69,"ndq":26707.98,"btc":82115.01,"gold":4105.0,"eurusd":1.1198,"spx_b":343.92,"ndq_b":493.39,"btc_b":9947.06,"gold_b":354.8,"eurusd_b":106.19,"spx_d":0.0,"ndq_d":0.0,"btc_d":-28.98,"gold_d":-18.23,"eurusd_d":-9.25}],"meta":[{"label":"calcular.py","value":"# Calcula las métricas del informe a partir de precios medios mensuales (dic 2016 - oct 2026).\nimport json, numpy as np, pandas as pd\nd = pd.read_csv('fred_raw.csv').merge(pd.read_csv('gold.csv').rename(columns={'Date':'month','Price':'gold'}), on='month')\ncols = ['spx','ndq','btc','gold','eurusd']\nnames = {'spx':'S&P 500','ndq':'Nasdaq Composite','btc':'Bitcoin','gold':'Oro','eurusd':'EUR/USD'}\ndf = d.set_index('month')[cols]; df.index = pd.to_datetime(df.index)\nret = df.pct_change().dropna()\nyrs = (len(df)-1)/12\nbase = df/df.iloc[0]*100\ndd = (df/df.cummax()-1)*100\ncagr = ((df.iloc[-1]/df.iloc[0])**(1/yrs)-1)*100\nvol = ret.std()*np.sqrt(12)*100\nserie = []\nfor m in df.index:\n    r = {'month': m.strftime('%Y-%m')}\n    for c in cols: r[c]=round(float(df.loc[m,c]),4)\n    for c in cols: r[c+'_b']=round(float(base.loc[m,c]),2)\n    for c in cols: r[c+'_d']=round(float(dd.loc[m,c]),2)\n    serie.append(r)\nmetricas = [{'key':c,'activo':names[c],'base100':round(float(base[c].iloc[-1]),1),'cagr':round(float(cagr[c]),1),\n  'vol':round(float(vol[c]),1),'mdd':round(float(dd[c].min()),1),'mdd_month':dd[c].idxmin().strftime('%Y-%m'),\n  'best':round(float(ret[c].max()*100),1),'worst':round(float(ret[c].min()*100),1),\n  'ratio':round(float(cagr[c]/vol[c]),2)} for c in cols]\ncorr = ret.corr()\ncorrel = [{'key':c,'activo':names[c],**{k:round(float(corr.loc[c,k]),2) for k in cols}} for c in cols]\nroll = ret['btc'].rolling(12).corr(ret['spx']).dropna()\ncorr12 = [{'month':m.strftime('%Y-%m'),'corr':round(float(v),2)} for m,v in roll.items()]\nyr = df.resample('YE').last().pct_change().dropna()*100\nanual = [{'year':str(i.year) if i.year<2026 else '2026*',**{c:round(float(yr.loc[i,c]),1) for c in cols}} for i in yr.index]\ndn = ret[ret.spx<0]; up = ret[ret.spx>0]\nbajada = [{'key':c,'activo':names[c],'en_caidas':round(float(dn[c].mean()*100),2),'en_subidas':round(float(up[c].mean()*100),2),'n_caidas':int(len(dn)),'n_subidas':int(len(up))} for c in cols]\nsrc = open(__file__).read() if '__file__' in globals() else ''\ndef meta(extra): return [{'label':'calcular.py','value':src,'type':'code','lang':'python'},{'label':'Entrada','value':'Precios medios mensuales, dic 2016 - oct 2026 (119 meses)'}]+extra\nfor n,rows,ex in [('serie',serie,[]),('metricas',metricas,[]),('correl',correl,[]),('corr12',corr12,[]),('anual',anual,[]),('bajada',bajada,[])]:\n    json.dump({'rows':rows,'meta':meta(ex)},open(f'{n}.json','w'),ensure_ascii=False,separators=(',',':'))\n    print(n,len(rows),len(open(f'{n}.json').read()),'bytes')\n","type":"code","lang":"python"},{"label":"Entrada","value":"Precios medios mensuales, dic 2016 - oct 2026 (119 meses)"}]}